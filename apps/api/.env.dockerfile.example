# Copy to apps/api/.env.dockerfile (gitignored). Loaded by docker compose via env_file on the api service.
# Keys here become container environment variables (see translation_tool.config.Settings).

LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://your-endpoint.example.com/openai/deployments/your-deployment
LLM_MODEL=your-model
LLM_API_KEY=
LLM_AUTH_SCHEME=api_key
LLM_API_VERSION=2025-04-01-preview
LLM_INCLUDE_MODEL_IN_BODY=false
LLM_JSON_OBJECT_RESPONSE=true
