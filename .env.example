# Copy to `.env` at the repository root (or under apps/api/). See translation_tool.config.Settings.

# If `tesseract` is not on PATH, set the full path to the binary:
# TESSERACT_CMD=/usr/bin/tesseract
# Directory with traineddata files (e.g. eng.traineddata); required for some installs (e.g. snap):
# TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata
# Docker Compose sets TESSERACT_CMD=/usr/bin/tesseract and TESSDATA_PREFIX=/tessdata (bundled in the API image).
# For local dev, clone https://github.com/tesseract-ocr/tessdata into ./tessdata/ before `docker compose build`.
