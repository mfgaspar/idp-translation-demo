# Copy to `.env` at the repository root (or under apps/api/). See translation_tool.config.Settings.

# If `tesseract` is not on PATH, set the full path to the binary:
# TESSERACT_CMD=/usr/bin/tesseract
# Directory with traineddata files (e.g. eng.traineddata); required for some installs (e.g. snap):
# TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata
# Chinese raster PDFs need chi_sim / chi_tra packs (e.g. apt install tesseract-ocr-chi-sim).
